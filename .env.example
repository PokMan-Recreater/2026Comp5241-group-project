# ---------------------------------------------------------------------------
# SkillForge environment variables
#
# The app is fully functional with NO variables set: every "AI" feature falls
# back to a deterministic, offline engine (see src/lib/ai/mock.ts).
#
# Copy this file to `.env.local` and fill in the values you want to enable.
# On Vercel, add them under Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# "mock" (default) or "openai".
# Leave as "mock" for a zero-cost, offline demo / grading build.
AI_PROVIDER=mock

# Only required when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
