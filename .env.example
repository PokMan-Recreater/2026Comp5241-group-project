# AI generation configuration; use matching provider URL, key, and model.
# Supabase settings below are required for account sign-in.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# Voice interview: one Groq key enables both chat and speech recognition.
# Copy this file to .env.local and fill values locally; never put keys in public/.
GROQ_API_KEY=
# Doubao Seeduplex realtime voice (local relay and Vercel WebSocket endpoint).
DOUBAO_REALTIME_API_KEY=
DOUBAO_REALTIME_VOICE=zh_female_vv_jupiter_bigtts
# Chat-only override (optional). When set, use a matching base URL and model.
INTERVIEW_API_KEY=
INTERVIEW_BASE_URL=
INTERVIEW_MODEL=
# Campus-only alternative:
# INTERVIEW_BASE_URL=https://genai.comp.polyu.edu.hk/api/v1
# INTERVIEW_MODEL=DeepSeek-V4-Flash
# The school endpoint works only from the PolyU campus network.

# Supabase accounts, courses, classrooms, and interviews (migrations required).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never include this in public assets or frontend variables.
SUPABASE_SECRET_KEY=

# Generate a random server-only secret for Vercel cron recovery.
CRON_SECRET=
