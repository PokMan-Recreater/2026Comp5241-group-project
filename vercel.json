{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/run.js": {
      "maxDuration": 60
    },
    "api/interview.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 60
    },
    "api/account.js": {
      "maxDuration": 60
    },
    "api/interview-records.js": {
      "maxDuration": 60
    },
    "api/interview-review-worker.js": {
      "maxDuration": 60
    },
    "api/teaching.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/course-narration.js": {
      "maxDuration": 120
    },
    "api/course-ai.js": {
      "maxDuration": 300
    },
    "api/realtime.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/interview-review-worker",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/realtime-status",
      "destination": "/api/realtime"
    }
  ]
}
