{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "public/academy-core.js",
    "public/academy-models.js",
    "public/academy-runner.js",
    "public/engine.js",
    "public/interview-review.js",
    "public/knowledge-checks.js",
    "public/topic-matching.js",
    "public/prompt-rewrite.js",
    "public/learning-links.js",
    "api/**/*.js",
    "scripts/**/*.mjs"
  ]
}
